[
 {
  "t0": 14.55,
  "t1": 21.1,
  "text": "窗外下着雨 房间里依然很冷清"
 },
 {
  "t0": 21.22,
  "t1": 28.35,
  "text": "等着你出现 从来没改变"
 },
 {
  "t0": 28.47,
  "t1": 35.3,
  "text": "昨晚想到你 被寂寞包裹的恐惧"
 },
 {
  "t0": 35.42,
  "t1": 41.27,
  "text": "等待黎明 等待深爱的你"
 },
 {
  "t0": 41.39,
  "t1": 48.3,
  "text": "能不能留下来再陪我数次星星"
 },
 {
  "t0": 48.42,
  "t1": 55.48,
  "text": "能不能别提起念念不忘的他"
 },
 {
  "t0": 55.6,
  "t1": 63.53,
  "text": "能不能告诉我你这次离开的各种原因"
 },
 {
  "t0": 63.65,
  "t1": 70.52,
  "text": "只能和孤独亲密 像小孩想要星星"
 },
 {
  "t0": 70.64,
  "t1": 77.23,
  "text": "忘不了你我互相的甜蜜"
 },
 {
  "t0": 77.35,
  "t1": 84.03,
  "text": "是你给我的最后的记忆"
 },
 {
  "t0": 84.15,
  "t1": 88.69,
  "text": "松开的手再抓不紧"
 },
 {
  "t0": 88.81,
  "t1": 92.47,
  "text": "等雨后等天晴"
 },
 {
  "t0": 92.59,
  "t1": 95.5,
  "text": "一起走的路都泥泞"
 },
 {
  "t0": 95.62,
  "t1": 98.76,
  "text": "沉睡向往的梦境"
 },
 {
  "t0": 98.88,
  "t1": 105.45,
  "text": "说来又说去还放不下你"
 },
 {
  "t0": 105.57,
  "t1": 112.39,
  "text": "最后再求你求你别离去"
 },
 {
  "t0": 112.51,
  "t1": 117.33,
  "text": "即便现实都已看清"
 },
 {
  "t0": 117.45,
  "t1": 121.04,
  "text": "镜子两面我破碎又织起"
 },
 {
  "t0": 121.16,
  "t1": 128.49,
  "text": "倔强的我最后过回了沉溺"
 },
 {
  "t0": 128.61,
  "t1": 132.14,
  "text": "渐渐两路模糊我视线"
 },
 {
  "t0": 132.26,
  "t1": 135.54,
  "text": "有一瞬间就将我冻结"
 },
 {
  "t0": 135.66,
  "t1": 142.47,
  "text": "重新连接的爱却又只能够妥协"
 },
 {
  "t0": 142.59,
  "t1": 146.11,
  "text": "于是我们又错过了时间"
 },
 {
  "t0": 146.23,
  "t1": 152.35,
  "text": "乌云密布了整个蓝天"
 },
 {
  "t0": 152.47,
  "t1": 159.21,
  "text": "忘不了你我互相的甜蜜"
 },
 {
  "t0": 159.33,
  "t1": 166.15,
  "text": "是你给我的最后的记忆"
 },
 {
  "t0": 166.27,
  "t1": 170.63,
  "text": "松开的手再抓不紧"
 },
 {
